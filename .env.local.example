# ── Clerk (Authentication) ─────────────────────────────────────────────
# Create an application at https://dashboard.clerk.com and copy the keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Where Clerk sends users. These defaults match the app's routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin

# ── Supabase (Database + Storage) ──────────────────────────────────────
# Create a project at https://supabase.com. Settings → API for the keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...            # safe for the browser (read-only via RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...                # SERVER ONLY — never expose to the client

# ── App ────────────────────────────────────────────────────────────────
# Comma-separated list of emails allowed into /admin (the client's email).
ADMIN_EMAILS=client@example.com
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
